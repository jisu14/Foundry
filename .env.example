# ==============================================================================
# Supabase Backend Configuration Template
# DO NOT commit real secrets (.env) to version control.
# ==============================================================================

# Your Supabase Project URL (found in Supabase Dashboard > Project Settings > API)
# Example: https://xyzcompany.supabase.co
SUPABASE_URL=

# Supabase Service Role Key (found in Supabase Dashboard > Project Settings > API > service_role)
# CRITICAL: This key bypasses Row Level Security. Keep it strictly on the backend.
# Never expose this in client-side / frontend code.
SUPABASE_SERVICE_ROLE_KEY=

# Custom Secret Header for Edge Function Invocation (e.g., x-importer-secret)
# Generate any secure random string or UUID
IMPORTER_SECRET=foundry_import_secret_change_me
